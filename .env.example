# ─────────────────────────────────────────────────────────────────────────────
# Portal Look — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no painel da Vercel.
# Para desenvolvimento local rápido: `npm run setup` gera um .env.local completo.
# NUNCA commite valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# Armazenamento: "local" (disco, só desenvolvimento) ou "vercel-blob" (produção).
# Se omitido, usa vercel-blob quando BLOB_READ_WRITE_TOKEN existir; senão local.
STORAGE_DRIVER=local

# Pasta usada pelo driver local (relativa à raiz do projeto).
LOCAL_STORAGE_DIR=.data

# Token do Vercel Blob (store PRIVADO). Criado automaticamente ao conectar o Blob ao projeto.
BLOB_READ_WRITE_TOKEN=

# Login do painel administrativo.
ADMIN_EMAIL=
# Gere com: npm run hash-password -- "sua senha forte"   (formato scrypt:N:r:p:salt:hash)
ADMIN_PASSWORD_HASH=

# Segredo que assina a sessão do ADM (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Segredo dos links dos clientes (HMAC + cifragem do token). Mínimo 32 caracteres.
# ATENÇÃO: trocar este valor invalida todos os links já enviados.
PORTAL_TOKEN_SECRET=

# URL pública usada para montar os links dos clientes.
PUBLIC_BASE_URL=https://clientes.lookassessoria.com.br

# Opcionais
# Duração da sessão do ADM, em horas.
SESSION_TTL_HOURS=12
# Tamanho máximo de upload (MB).
UPLOAD_MAX_MB=25
# Acima deste tamanho (MB), o upload vai direto do navegador para o Blob (limite da função: 4,5 MB).
SERVER_UPLOAD_MAX_MB=4
# Fuso usado para "hoje" (prazos de entrega) e exibição de datas.
APP_TIMEZONE=America/Sao_Paulo
